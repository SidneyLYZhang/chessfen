# Copy this file to .env and adjust the values; docker compose reads it
# automatically. Never commit the real .env file.
#
# The two placeholders below are NOT secure: replace them with real values
# before starting, otherwise the admin page uses a publicly known password.

ADMIN_PASSWORD=replace-with-a-strong-password
SECRET_KEY=replace-with-a-long-random-secret

# CHESSFEN_IMAGE=ghcr.io/sidneylyzhang/chessfen:latest
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/chessfen
# FORWARDED_ALLOW_IPS=172.18.0.0/16
